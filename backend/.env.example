# ─────────────────────────────────────────────────────────────
# Base de données — Supabase (projet "venipsshop")
# ─────────────────────────────────────────────────────────────
# Récupère la chaîne exacte dans : Supabase Dashboard → projet venipsshop
#   → bouton "Connect" → ORMs / Prisma.
#
# Recommandé (Session pooler, compatible IPv4, fonctionne avec
# `prisma db push` et un serveur long-running comme Railway) :
DATABASE_URL="postgresql://postgres.uzbgzvhietfzscephwtm:[MOT_DE_PASSE]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
#
# Alternative — connexion directe (IPv6) :
# DATABASE_URL="postgresql://postgres:[MOT_DE_PASSE]@db.uzbgzvhietfzscephwtm.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Serveur
# ─────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="4000"
FRONTEND_URL="https://ton-front.example"

# ─────────────────────────────────────────────────────────────
# Authentification JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET="change-moi"
JWT_REFRESH_SECRET="change-moi-aussi"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─────────────────────────────────────────────────────────────
# Emails (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Venips <noreply@venips.gn>"
ADMIN_EMAIL="admin@venips.gn"

# ─────────────────────────────────────────────────────────────
# Upload images (Cloudinary)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
